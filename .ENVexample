# .env
# Solana wallet private key (base58-encoded) for TradingBot
PRIVATE_KEY=your_base58_private_key_here

# Solana RPC endpoint for blockchain interactions
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Telegram bot token for TelegramBot initialization
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID of the bot owner for special permissions
OWNER_TELEGRAM_ID=your_telegram_chat_id_here

# Gemini API key for AI-related features (e.g., reporting or analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Trigger API base URL for limit orders (buy/sell at specific price)
TRIGGER_API=https://api.example.com/trigger/v1

# Ultra Swap API base URL for instant buy/sell orders
ULTRA_API=https://api.example.com/ultra/v1

# DexScreener API base URL for fetching token data (market cap, price, name)
DEXSCREENER_API=https://api.dexscreener.com/latest/dex/tokens

# SOL logo/emoji for display in Telegram messages
SOL_LOGO=◎

# Optional: Fee percentages (defined in config.py, not typically in .env)
# FEE_PERCENTAGES=1.0

# Optional: Name update cooldown in seconds (defined in config.py)
# NAME_UPDATE_COOLDOWN=1209600  # 14 days